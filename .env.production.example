# Kora production configuration (copy to .env on the server and fill the blanks).
#
# Nested settings use the "__" separator (pydantic-settings). Compose re-asserts
# the service hostnames via `environment`, so the hosts below are only used when
# the app runs on the bare host.

ENVIRONMENT=production
SERVICE_NAME=kora

# --- PostgreSQL -------------------------------------------------------------
# Keep DATABASE__PASSWORD and POSTGRES_PASSWORD identical.
POSTGRES_USER=kora
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=kora
DATABASE__USER=kora
DATABASE__PASSWORD=CHANGE_ME_DB_PASSWORD
DATABASE__DATABASE=kora
DATABASE__HOST=postgres
DATABASE__PORT=5432
DATABASE__POOL_SIZE=20
DATABASE__MAX_OVERFLOW=10
DATABASE__POOL_TIMEOUT=5
DATABASE__POOL_RECYCLE=1800
DATABASE__STATEMENT_TIMEOUT_MS=15000
DATABASE__APPLICATION_NAME=kora

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=100

# --- RabbitMQ ---------------------------------------------------------------
RABBITMQ_USER=kora
RABBITMQ_PASS=CHANGE_ME_BROKER_PASSWORD
BROKER__PREFETCH=64
BROKER__RETRY_DELAY_MS=1000
BROKER__MAX_RETRIES=5

# --- S3 / MinIO media -------------------------------------------------------
OBJECT_STORAGE__ACCESS_KEY=CHANGE_ME_MINIO_ACCESS
OBJECT_STORAGE__SECRET_KEY=CHANGE_ME_MINIO_SECRET
OBJECT_STORAGE__BUCKET=kora-media
OBJECT_STORAGE__REGION=us-east-1
OBJECT_STORAGE__URL_TTL_SECONDS=300
OBJECT_STORAGE__PRESIGNED_URL_TTL_SECONDS=900

# --- Encryption / signing ---------------------------------------------------
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=CHANGE_ME_32_BYTE_BASE64
OUTBOUND_WEBHOOK_SIGNING_SECRET=CHANGE_ME_RANDOM
PAYMENT__WEBHOOK_SECRET=CHANGE_ME_RANDOM

# --- AI (OpenRouter) --------------------------------------------------------
AI__PROVIDER=openrouter
AI__BASE_URL=https://openrouter.ai/api/v1
AI__API_KEY=CHANGE_ME_OPENROUTER_KEY
AI__DEFAULT_MODEL=google/gemini-2.5-flash
AI__FALLBACK_MODEL=google/gemini-2.5-pro
AI__REQUEST_TIMEOUT_SECONDS=12
AI__MAX_OUTPUT_TOKENS=1024
AI__TEMPERATURE=0.2
AI__DAILY_BUDGET_USD=25
AI__PER_USER_DAILY_BUDGET_USD=0.25
AI__PIPELINE_ENABLED=true
AI__MODEL_PRICING_USD_PER_MILLION={"google/gemini-2.5-flash": {"input": 0.3, "output": 2.5}, "google/gemini-2.5-pro": {"input": 1.25, "output": 10.0}}

# --- WhatsApp gateway (Baileys) ---------------------------------------------
# Generate: openssl rand -hex 32. Must be identical for the API and the gateway.
WHATSAPP__GATEWAY_URL=http://baileys:3000
WHATSAPP__API_KEY=CHANGE_ME_WHATSAPP_API_KEY
WHATSAPP__SESSION_NAME=kora-main
WHATSAPP__MAX_OUTBOUND_PER_MINUTE=120

# --- Payments ---------------------------------------------------------------
PAYMENT__SERVICE_FEE_XAF=1000
PAYMENT__GATEWAY=mock
PAYMENT__CALLBACK_TOLERANCE_SECONDS=300

# --- Fraud ------------------------------------------------------------------
FRAUD__MEDIUM_RISK_THRESHOLD=40
FRAUD__HIGH_RISK_THRESHOLD=70
FRAUD__CRITICAL_RISK_THRESHOLD=90
FRAUD__PRICE_ANOMALY_RATIO=0.4
FRAUD__MAX_ACTIVE_PROPERTIES_PER_LANDLORD=25

# --- Observability ----------------------------------------------------------
OBSERVABILITY__LOG_LEVEL=INFO
OBSERVABILITY__LOG_JSON=true
OBSERVABILITY__METRICS_ENABLED=true
OBSERVABILITY__METRICS_PORT=9100
OBSERVABILITY__TRACING_ENABLED=false
OBSERVABILITY__OTLP_ENDPOINT=
