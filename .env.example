# Loka configuration.
#
# Nested settings use the "__" separator (pydantic-settings), e.g.
# DATABASE__HOST=postgres. Values target the docker compose network; compose
# re-asserts them via `environment` (which wins over this file). For a run on
# the bare host replace the service names with localhost:5432 / localhost:6380
# (Redis is published on 6380 locally because a host redis-server owns 6379).

ENVIRONMENT=development
SERVICE_NAME=loka

# --- PostgreSQL -------------------------------------------------------------
DATABASE__HOST=postgres
DATABASE__PORT=5432
DATABASE__USER=loka
DATABASE__PASSWORD=loka
DATABASE__DATABASE=loka
DATABASE__POOL_SIZE=20
DATABASE__MAX_OVERFLOW=10
DATABASE__POOL_TIMEOUT=5
DATABASE__POOL_RECYCLE=1800
DATABASE__STATEMENT_TIMEOUT_MS=15000
DATABASE__APPLICATION_NAME=loka

# --- Redis (rate limiting, idempotency, locks, cache) -----------------------
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=100

# --- RabbitMQ ---------------------------------------------------------------
BROKER__URL=amqp://loka:loka@rabbitmq:5672/
BROKER__PREFETCH=64
BROKER__RETRY_DELAY_MS=1000
BROKER__MAX_RETRIES=5

# --- S3 / MinIO media -------------------------------------------------------
OBJECT_STORAGE__ENDPOINT=http://minio:9000
OBJECT_STORAGE__ACCESS_KEY=minioadmin
OBJECT_STORAGE__SECRET_KEY=minioadmin
OBJECT_STORAGE__BUCKET=loka-media
OBJECT_STORAGE__REGION=us-east-1
OBJECT_STORAGE__URL_TTL_SECONDS=300
OBJECT_STORAGE__PRESIGNED_URL_TTL_SECONDS=900

# --- Encryption / signing ---------------------------------------------------
# 32 bytes, base64 encoded. Generate with:
#   python -c "import base64,secrets;print(base64.b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_KEY=Zm9yLWRldi1vbmx5LTMyLWJ5dGVzLWtleS0zMmJ5dGVzLWtleSE=
OUTBOUND_WEBHOOK_SIGNING_SECRET=change-me

# --- AI (OpenRouter) --------------------------------------------------------
AI__PROVIDER=openrouter
AI__BASE_URL=https://openrouter.ai/api/v1
AI__API_KEY=
AI__DEFAULT_MODEL=google/gemini-2.5-flash
AI__FALLBACK_MODEL=google/gemini-2.5-pro
AI__REQUEST_TIMEOUT_SECONDS=12
AI__MAX_OUTPUT_TOKENS=1024
AI__TEMPERATURE=0.2
AI__DAILY_BUDGET_USD=25
AI__PER_USER_DAILY_BUDGET_USD=0.25
# true is refused at boot until every configured model has a price below.
AI__PIPELINE_ENABLED=false
AI__MODEL_PRICING_USD_PER_MILLION={"google/gemini-2.5-flash": {"input": 0.3, "output": 2.5}, "google/gemini-2.5-pro": {"input": 1.25, "output": 10.0}}

# --- WhatsApp gateway (Baileys) ---------------------------------------------
WHATSAPP__GATEWAY_URL=http://baileys:3000
WHATSAPP__API_KEY=
WHATSAPP__SESSION_NAME=loka-main
WHATSAPP__MAX_OUTBOUND_PER_MINUTE=120

# --- Payments ---------------------------------------------------------------
PAYMENT__SERVICE_FEE_XAF=1000
PAYMENT__WEBHOOK_SECRET=change-me
# mock for local work and the test suite, fapshi in staging and production.
PAYMENT__GATEWAY=mock
PAYMENT__CALLBACK_TOLERANCE_SECONDS=300
# A payment still pending after this many minutes is asked about directly.
PAYMENT__RECONCILE_AFTER_MINUTES=10

# --- Fapshi ------------------------------------------------------------------
# Sandbox and live are separate hosts with separate credential pairs:
#   https://sandbox.fapshi.com   https://live.fapshi.com
# The live key is shown once, at service creation, and never again.
PAYMENT__FAPSHI__BASE_URL=https://sandbox.fapshi.com
PAYMENT__FAPSHI__API_USER=
PAYMENT__FAPSHI__API_KEY=
# Set the same value on the Fapshi dashboard, under the service's webhook
# secret. Fapshi echoes it verbatim in the `x-wh-secret` header, so it proves
# who is calling and nothing about the body — which is why every webhook is
# confirmed against GET /payment-status before a payment settles. It travels in
# clear text, so the webhook URL must be https.
PAYMENT__FAPSHI__WEBHOOK_SECRET=
PAYMENT__FAPSHI__REQUEST_TIMEOUT_SECONDS=15
# Webhook URL to register on the dashboard, one per service:
#   https://<votre-domaine>/webhooks/payments/fapshi
# Left empty, the payer stays on Fapshi's own confirmation screen, which is
# what we want: on WhatsApp the thread is where the conversation resumes.
PAYMENT__FAPSHI__REDIRECT_URL=

# --- Fraud ------------------------------------------------------------------
FRAUD__MEDIUM_RISK_THRESHOLD=40
FRAUD__HIGH_RISK_THRESHOLD=70
FRAUD__CRITICAL_RISK_THRESHOLD=90
FRAUD__PRICE_ANOMALY_RATIO=0.4
FRAUD__MAX_ACTIVE_PROPERTIES_PER_LANDLORD=25

# --- Observability ----------------------------------------------------------
OBSERVABILITY__LOG_LEVEL=INFO
OBSERVABILITY__LOG_JSON=true
OBSERVABILITY__METRICS_ENABLED=true
OBSERVABILITY__METRICS_PORT=9100
OBSERVABILITY__TRACING_ENABLED=false
OBSERVABILITY__OTLP_ENDPOINT=
